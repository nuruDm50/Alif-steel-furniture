  {id:3, name:'4-Door Premium Wardrobe', brand:'Alif Steel', category:'wardrobe', price:18000, oldPrice:22000, discount:18, rating:4.9, reviews:67, image:'https://images.unsplash.com/photo-1616594039964-ae9021a400a0?w=400&q=80', badge:'sale', colors:['#1a1a1a','#8B4513'], sizes:['Large','XL'], stock:8, description:'Our flagship 4-door premium wardrobe. Massive storage, elegant mirror design, lifetime warranty.', featured:true, bestseller:true},

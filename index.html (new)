<script>
// ======== DATA ========
const products = [
  {id:1, name:'4-Drower & 1 Door Steel Wardrobe', brand:'Alif Steel', category:'wardrobe', price:25000, oldPrice:27000, discount:22, rating:4.8, reviews:124, 'image4doorwardrob badge:'sale', colors:['#1a1a1a','#888','#8B4513'], sizes:['Standard','Large','XL'], stock:15, description:'Premium steel wardrobe. Rust-proof, powder-coated finish. Perfect for master bedroom.', featured:true, bestseller:false},

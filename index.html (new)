  {id:5, name:'3-Drawer Steel Cabinet', brand:'Alif Steel', category:'cabinet', price:6800, oldPrice:8000, discount:15, rating:4.6, reviews:38, image:'https://images.unsplash.com/photo-1558618666-fcd25c85cd64?w=400&q=80', badge:'new', colors:['#888','#1a1a1a','#8B4513'], sizes:['Standard','Large'], stock:18, description:'3-drawer steel filing cabinet. Smooth glide drawers, lockable, perfect for office documents.', featured:true, bestseller:false},
  {id:6, name:'Sliding Door Wardrobe', brand:'Alif Steel', category:'wardrobe', price:15500, oldPrice:19000, discount:18, rating:4.8, reviews:92, image:'https://images.unsplash.com/photo-1586023492125-27b2c045efd7?w=400&q=80', badge:'sale', colors:['#1a1a1a','#c0c0c0'], sizes:['Standard','Large','XL'], stock:12, description:'Modern sliding-door wardrobe with full-length mirror. Space-saving design, premium quality steel.', featured:true, bestseller:true},
  {id:7, name:'Kids Steel Almirah', brand:'Alif Steel', category:'almirah', price:5900, oldPrice:7000, discount:16, rating:4.7, reviews:55, image:'https://images.unsplash.com/photo-1524758631624-e2822e304c36?w=400&q=80', badge:'new', colors:['#FFB6C1','#87CEEB','#98FB98'], sizes:['Standard'], stock:20, description:'Colorful and safe steel almirah for kids. Rounded edges, non-toxic paint, easy-open handles.', featured:false, bestseller:true},
  {id:8, name:'Heavy-Duty Locker Set (3)', brand:'Alif Steel', category:'locker', price:9800, oldPrice:12000, discount:18, rating:4.6, reviews:41, image:'https://images.unsplash.com/photo-1556909114-f6e7ad7d3136?w=400&q=80', badge:'sale', colors:['#888','#1a1a1a'], sizes:['Standard'], stock:9, description:'Set of 3 heavy-duty steel lockers. Ideal for office, gym, school. Each has separate key locks.', featured:false, bestseller:false},
];

let cart = JSON.parse(localStorage.getItem('alifCart') || '[]');
let wishlist = JSON.parse(localStorage.getItem('alifWish') || '[]');
let currentPage = 'home';
let slideIndex = 0;
let slideTimer;
let selectedPayment = 'bkash';
let orderCounter = parseInt(localStorage.getItem('alifOrderCounter') || '0');

// ======== INIT ========
document.addEventListener('DOMContentLoaded', () => {
  renderHeroDots();
  startSlider();
  renderProducts('featured', products.filter(p=>p.featured).slice(0,4), 'featured-products');
  renderProducts('sale', products.filter(p=>p.badge==='sale').slice(0,4), 'sale-products');
  renderProducts('bestseller', products.filter(p=>p.bestseller).slice(0,4), 'bestseller-products');
  renderProducts('shop', products, 'shop-products');
  updateBadges();
  startCountdown();
  window.addEventListener('scroll', onScroll);
  // Admin nav style for shop layout
  const shopLayout = document.querySelector('.shop-layout');
  if(shopLayout){ shopLayout.style.gridTemplateColumns = '220px 1fr'; }
});

// ======== PAGES ========
function showPage(page){
  document.querySelectorAll('.page').forEach(p=>{p.style.display='none';p.classList.remove('active')});
  const el = document.getElementById(page+'-page');
  if(!el) return;
  el.style.display = page==='login'?'flex':'block';
  el.classList.add('active');
  currentPage = page;
  window.scrollTo(0,0);
  // Update nav active
  document.querySelectorAll('.desktop-nav-inner a').forEach(a=>{a.classList.remove('active')});
  if(page==='wishlist') renderWishlistPage();
  if(page==='checkout') renderCheckout();
}

// ======== HERO SLIDER ========
function renderHeroDots(){
  const slides = document.querySelectorAll('.hero-slide');
  const dots = document.getElementById('hero-dots');
  dots.innerHTML = '';
  slides.forEach((_,i)=>{
    const d = document.createElement('button');
    d.className = 'hero-dot'+(i===0?' active':'');
    d.onclick = ()=>goSlide(i);
    dots.appendChild(d);
  });
}
function startSlider(){
  slideTimer = setInterval(()=>changeSlide(1), 4500);
}
function changeSlide(dir){
  const slides = document.querySelectorAll('.hero-slide');
  slides[slideIndex].classList.remove('active');
  document.querySelectorAll('.hero-dot')[slideIndex].classList.remove('active');
  slideIndex = (slideIndex + dir + slides.length) % slides.length;
  slides[slideIndex].classList.add('active');
  document.querySelectorAll('.hero-dot')[slideIndex].classList.add('active');
  clearInterval(slideTimer);
  startSlider();
}
function goSlide(i){
  const slides = document.querySelectorAll('.hero-slide');
  slides[slideIndex].classList.remove('active');
  document.querySelectorAll('.hero-dot')[slideIndex].classList.remove('active');
  slideIndex = i;
  slides[slideIndex].classList.add('active');
  document.querySelectorAll('.hero-dot')[slideIndex].classList.add('active');
}

// ======== RENDER PRODUCTS ========
function renderProducts(context, prods, containerId){
  const el = document.getElementById(containerId);
  if(!el) return;
  if(prods.length===0){el.innerHTML='<p style="color:var(--gray-500);padding:20px">No products found.</p>';return;}
  el.innerHTML = prods.map(p=>productCard(p)).join('');
}
function productCard(p){
  const inWish = wishlist.includes(p.id);
  return `<div class="product-card" onclick="openModal(${p.id})">
    <div class="product-img-wrap">
      <img src="${p.image}" alt="${p.name}" loading="lazy">
      <div class="product-badge">
        ${p.badge==='sale'?'<span class="badge-sale">SALE</span>':''}
        ${p.badge==='new'?'<span class="badge-new">NEW</span>':''}
      </div>
      <button class="wishlist-btn ${inWish?'active':''}" onclick="toggleWish(event,${p.id})" title="Wishlist">
        <svg viewBox="0 0 24 24" fill="${inWish?'currentColor':'none'}" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
      </button>
    </div>
    <div class="product-info">
      <p class="product-brand">${p.brand}</p>
      <p class="product-name">${p.name}</p>
      <div class="product-rating">
        <span class="stars">${'★'.repeat(Math.floor(p.rating))}${'☆'.repeat(5-Math.floor(p.rating))}</span>
        <span class="rating-count">(${p.reviews})</span>
      </div>
      <div class="product-price">
        <span class="price-current">৳${p.price.toLocaleString()}</span>
        ${p.oldPrice?`<span class="price-old">৳${p.oldPrice.toLocaleString()}</span><span class="price-discount">-${p.discount}%</span>`:''}
      </div>
      <button class="add-cart-btn" onclick="event.stopPropagation();addToCart(${p.id})">Add to Cart</button>
    </div>
  </div>`;
}

// ======== CART ========
function addToCart(id){
  const p = products.find(x=>x.id===id);
  if(!p) return;
  const existing = cart.find(x=>x.id===id);
  if(existing) existing.qty++;
  else cart.push({id, qty:1});
  saveCart();
  updateBadges();
  showToast(`${p.name} added to cart!`, 'success');
}
function removeFromCart(id){
  cart = cart.filter(x=>x.id!==id);
  saveCart();
  updateBadges();
  renderCartDrawer();
}
function updateQty(id, delta){
  const item = cart.find(x=>x.id===id);
  if(!item) return;
  item.qty = Math.max(1, item.qty + delta);
  saveCart();
  updateBadges();
  renderCartDrawer();
}
function saveCart(){ localStorage.setItem('alifCart', JSON.stringify(cart)); }
function saveWish(){ localStorage.setItem('alifWish', JSON.stringify(wishlist)); }
function updateBadges(){
  const total = cart.reduce((s,x)=>s+x.qty,0);
  ['cart-badge','floating-badge'].forEach(id=>{
    const el = document.getElementById(id);
    if(el) el.textContent = total;
  });
  const wishEl = document.getElementById('wish-badge');
  if(wishEl) wishEl.textContent = wishlist.length;
}
function openCart(){
  document.getElementById('cart-drawer').classList.add('open');
  document.getElementById('cart-overlay').classList.add('open');
  renderCartDrawer();
}
function closeCart(){
  document.getElementById('cart-drawer').classList.remove('open');
  document.getElementById('cart-overlay').classList.remove('open');
}
function renderCartDrawer(){
  const list = document.getElementById('cart-items-list');
  const footer = document.getElementById('cart-footer');
  if(cart.length===0){
    list.innerHTML=`<div class="empty-cart"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg><p>Your cart is empty</p><button onclick="closeCart();showPage('shop')">Shop Now</button></div>`;
    footer.style.display='none';return;
  }
  const subtotal = cart.reduce((s,x)=>{const p=products.find(y=>y.id===x.id);return s+(p?p.price*x.qty:0);},0);
  const shipping = subtotal > 20000 ? 0 : 120;
  list.innerHTML = cart.map(item=>{
    const p = products.find(y=>y.id===item.id);
    if(!p) return '';
    return `<div class="cart-item">
      <img class="cart-item-img" src="${p.image}" alt="${p.name}" loading="lazy">
      <div class="cart-item-info">
        <p class="cart-item-name">${p.name}</p>
        <p class="cart-item-variant">Steel Wardrobe</p>
        <p class="cart-item-price">৳${(p.price*item.qty).toLocaleString()}</p>
        <div class="cart-qty">
          <button class="qty-btn" onclick="updateQty(${p.id},-1)">−</button>
          <span class="qty-val">${item.qty}</span>
          <button class="qty-btn" onclick="updateQty(${p.id},1)">+</button>
          <button onclick="removeFromCart(${p.id})" style="margin-left:auto;color:var(--red);font-size:1.1rem">×</button>
        </div>
      </div>
    </div>`;
  }).join('');
  document.getElementById('cart-subtotal').textContent = '৳'+subtotal.toLocaleString();
  document.getElementById('cart-shipping').textContent = shipping===0?'Free':'৳'+shipping;
  document.getElementById('cart-total').textContent = '৳'+(subtotal+shipping).toLocaleString();
  footer.style.display='block';
}

// ======== WISHLIST ========
function toggleWish(e, id){
  e.stopPropagation();
  if(wishlist.includes(id)) wishlist = wishlist.filter(x=>x!==id);
  else wishlist.push(id);
  saveWish();
  updateBadges();
  // Re-render all product grids
  renderProducts('featured', products.filter(p=>p.featured).slice(0,4), 'featured-products');
  renderProducts('sale', products.filter(p=>p.badge==='sale').slice(0,4), 'sale-products');
  renderProducts('bestseller', products.filter(p=>p.bestseller).slice(0,4), 'bestseller-products');
  renderProducts('shop', products, 'shop-products');
  if(currentPage==='wishlist') renderWishlistPage();
}
function renderWishlistPage(){
  const prods = products.filter(p=>wishlist.includes(p.id));
  const el = document.getElementById('wishlist-products');
  const empty = document.getElementById('empty-wishlist');
  if(prods.length===0){el.innerHTML='';empty.style.display='block';}
  else{empty.style.display='none';renderProducts('wish',prods,'wishlist-products');}
}

// ======== MODAL / QUICK VIEW ========
function openModal(id){
  const p = products.find(x=>x.id===id);
  if(!p) return;
  const inWish = wishlist.includes(p.id);
  document.getElementById('modal-body').innerHTML = `
    <div class="modal-imgs"><img src="${p.image}" alt="${p.name}"></div>
    <div class="modal-info">
      <p class="modal-brand">${p.brand} · ${p.category.toUpperCase()}</p>
      <h2 class="modal-name">${p.name}</h2>
      <div class="modal-price-row">
        <span class="modal-price">৳${p.price.toLocaleString()}</span>
        ${p.oldPrice?`<span class="modal-old-price">৳${p.oldPrice.toLocaleString()}</span><span class="modal-discount">-${p.discount}%</span>`:''}
      </div>
      <div style="display:flex;align-items:center;gap:6px;margin-bottom:14px">
        <span style="color:#f5a623">${'★'.repeat(Math.floor(p.rating))}${'☆'.repeat(5-Math.floor(p.rating))}</span>
        <span style="font-size:0.78rem;color:var(--gray-500)">(${p.reviews} reviews)</span>
        <span style="font-size:0.75rem;color:#22c55e;margin-left:8px">●  ${p.stock>0?p.stock+' in stock':'Out of stock'}</span>
      </div>
      <p class="modal-desc">${p.description}</p>
      <p class="modal-label">Color</p>
      <div class="color-opts">${p.colors.map((c,i)=>`<div class="color-opt ${i===0?'selected':''}" style="background:${c}" onclick="this.parentNode.querySelectorAll('.color-opt').forEach(x=>x.classList.remove('selected'));this.classList.add('selected')"></div>`).join('')}</div>
      <p class="modal-label">Size</p>
      <div class="size-opts">${p.sizes.map((s,i)=>`<div class="size-opt ${i===0?'selected':''}" onclick="this.parentNode.querySelectorAll('.size-opt').forEach(x=>x.classList.remove('selected'));this.classList.add('selected')">${s}</div>`).join('')}</div>
      <div class="modal-actions">
        <button class="modal-cart-btn" onclick="addToCart(${p.id});closeModal()">Add to Cart 🛒</button>
        <button class="modal-wish-btn ${inWish?'active':''}" onclick="toggleWish(event,${p.id});this.classList.toggle('active')" style="${inWish?'border-color:var(--red);color:var(--red)':''}">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="${inWish?'currentColor':'none'}" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
        </button>
      </div>
    </div>`;
  document.getElementById('modal-overlay').classList.add('open');
}
function closeModal(){
  document.getElementById('modal-overlay').classList.remove('open');
}

// ======== CHECKOUT ========
function renderCheckout(){
  const items = document.getElementById('checkout-items');
  const lines = document.getElementById('order-lines');
  if(!items || !lines) return;
  const subtotal = cart.reduce((s,x)=>{const p=products.find(y=>y.id===x.id);return s+(p?p.price*x.qty:0);},0);
  const shipping = subtotal > 20000 ? 0 : 120;
  items.innerHTML = cart.map(item=>{
    const p = products.find(y=>y.id===item.id);
    if(!p) return '';
    return `<div style="display:flex;justify-content:space-between;font-size:0.85rem;margin-bottom:8px"><span>${p.name} ×${item.qty}</span><strong>৳${(p.price*item.qty).toLocaleString()}</strong></div>`;
  }).join('');
  lines.innerHTML = `
    <div class="order-line"><span>Subtotal</span><span>৳${subtotal.toLocaleString()}</span></div>
    <div class="order-line"><span>Shipping</span><span>${shipping===0?'Free':'৳'+shipping}</span></div>
    <div class="order-line total"><span>Total</span><strong>৳${(subtotal+shipping).toLocaleString()}</strong></div>`;
}
function selectPayment(el, method){
  document.querySelectorAll('.payment-method').forEach(x=>x.classList.remove('selected'));
  el.classList.add('selected');
  selectedPayment = method;
}
function applyCoupon(){
  const v = document.getElementById('coupon-input').value.trim().toUpperCase();
  if(v==='ALIF10'||v==='EID2025'){showToast('Coupon applied! 10% off','success');}
  else{showToast('Invalid coupon code','error');}
}
function placeOrder(){
  if(cart.length===0){showToast('Your cart is empty!','error');return;}
  orderCounter++;
  localStorage.setItem('alifOrderCounter', orderCounter);
  const orderId = '#ASF-2025-'+String(orderCounter).padStart(4,'0');
  document.getElementById('success-order-id').textContent = 'Order '+orderId;
  cart = []; saveCart(); updateBadges();
  showPage('order-success');
}

// ======== SHOP FILTERS ========
function filterByCategory(cat){
  showPage('shop');
  const checks = document.querySelectorAll('#cat-filters input');
  checks.forEach(c=>c.checked = c.value===cat||c.value==='all'&&false);
  const allCheck = Array.from(checks).find(c=>c.value==='all');
  if(allCheck) allCheck.checked = false;
  const catCheck = Array.from(checks).find(c=>c.value===cat);
  if(catCheck) catCheck.checked = true;
  applyFilters();
}
function applyFilters(){
  const maxPrice = parseInt(document.getElementById('price-filter').value);
  const sort = document.getElementById('sort-select').value;
  const checks = Array.from(document.querySelectorAll('#cat-filters input:checked')).map(c=>c.value);
  let filtered = products.filter(p=>{
    const catMatch = checks.includes('all')||checks.includes(p.category);
    const priceMatch = p.price<=maxPrice;
    return catMatch&&priceMatch;
  });
  if(sort==='price-asc') filtered.sort((a,b)=>a.price-b.price);
  if(sort==='price-desc') filtered.sort((a,b)=>b.price-a.price);
  if(sort==='rating') filtered.sort((a,b)=>b.rating-a.rating);
  document.getElementById('product-count').textContent = `Showing ${filtered.length} product${filtered.length!==1?'s':''}`;
  renderProducts('shop', filtered, 'shop-products');
}
function updatePriceFilter(val){
  document.getElementById('price-display').textContent = '৳'+parseInt(val).toLocaleString();
  applyFilters();
}
function handleSearch(val){
  if(!val) return;
  const results = products.filter(p=>p.name.toLowerCase().includes(val.toLowerCase())||p.category.toLowerCase().includes(val.toLowerCase()));
  showPage('shop');
  renderProducts('shop', results, 'shop-products');
  document.getElementById('product-count').textContent = `${results.length} results for "${val}"`;
}

// ======== TOAST ========
function showToast(msg, type=''){
  const container = document.getElementById('toast-container');
  const t = document.createElement('div');
  t.className = `toast ${type}`;
  t.textContent = msg;
  container.appendChild(t);
  requestAnimationFrame(()=>{ requestAnimationFrame(()=>t.classList.add('show')); });
  setTimeout(()=>{t.classList.remove('show');setTimeout(()=>t.remove(),300);}, 2500);
}

// ======== COUNTDOWN ========
function startCountdown(){
  let endTime = Date.now() + (5*3600+42*60+17)*1000;
  function tick(){
    const rem = Math.max(0, Math.floor((endTime-Date.now())/1000));
    const h = Math.floor(rem/3600), m = Math.floor((rem%3600)/60), s = rem%60;
    const hEl=document.getElementById('c-h'), mEl=document.getElementById('c-m'), sEl=document.getElementById('c-s');
    if(hEl) hEl.textContent = String(h).padStart(2,'0');
    if(mEl) mEl.textContent = String(m).padStart(2,'0');
    if(sEl) sEl.textContent = String(s).padStart(2,'0');
  }
  tick(); setInterval(tick, 1000);
}


.form-group{display:flex;flex-direction:column;gap:6px}
.form-label{font-size:0.8rem;font-weight:600;color:var(--gray-700)}
.form-input{padding:10px 14px;border-radius:8px;border:1.5px solid var(--gray-200);font-size:0.9rem;outline:none;transition:border-color var(--transition);width:100%}
.form-input:focus{border-color:var(--black)}
.payment-methods{display:flex;flex-direction:column;gap:10px}
.payment-method{border:1.5px solid var(--gray-200);border-radius:10px;padding:14px;cursor:pointer;transition:border-color var(--transition);display:flex;align-items:center;gap:12px}
.payment-method.selected{border-color:var(--black);background:var(--gray-100)}
.payment-method-icon{width:40px;height:28px;border-radius:4px;display:flex;align-items:center;justify-content:center;font-size:0.75rem;font-weight:800}
.pm-bkash{background:#e2136e;color:var(--white)}
.pm-nagad{background:#f7941d;color:var(--white)}
.pm-cod{background:var(--gray-200);color:var(--black)}
.order-summary-box{background:var(--white);border-radius:14px;border:1px solid var(--gray-200);padding:24px;position:sticky;top:80px}
.order-line{display:flex;justify-content:space-between;font-size:0.88rem;margin-bottom:10px;color:var(--gray-700)}
.order-line.total{font-weight:700;font-size:1.05rem;color:var(--black);border-top:1px solid var(--gray-200);padding-top:12px;margin-top:4px}
.place-order-btn{width:100%;padding:15px;background:var(--red);color:var(--white);border-radius:var(--btn-radius);font-weight:700;font-size:1rem;margin-top:16px;transition:background var(--transition)}
.place-order-btn:hover{background:var(--red-dark)}
.coupon-row{display:flex;gap:8px;margin:14px 0}
.coupon-row input{flex:1;padding:9px 14px;border-radius:7px;border:1.5px solid var(--gray-200);font-size:0.88rem;outline:none}
.coupon-row button{padding:9px 16px;background:var(--black);color:var(--white);border-radius:7px;font-size:0.82rem;font-weight:600}

/* ======= ORDER SUCCESS ======= */
#order-success{display:none;padding:80px 0;text-align:center}
.success-icon{width:72px;height:72px;background:#e8f5e9;border-radius:50%;display:flex;align-items:center;justify-content:center;margin:0 auto 20px;font-size:2rem}
.success-title{font-family:'Playfair Display',serif;font-size:1.8rem;font-weight:800;margin-bottom:10px}
.success-sub{color:var(--gray-500);font-size:0.92rem;margin-bottom:24px}
.order-id{background:var(--gray-100);padding:12px 20px;border-radius:8px;font-weight:700;font-size:1rem;display:inline-block;margin-bottom:24px}

/* ======= ADMIN PANEL ======= */
#admin-panel{display:none;min-height:100vh;padding-top:60px}
.admin-layout{display:flex;min-height:calc(100vh - 60px)}
.admin-sidebar{width:240px;background:var(--black);color:var(--white);flex-shrink:0;padding:24px 0;display:none}
@media(min-width:768px){.admin-sidebar{display:flex;flex-direction:column}}
.admin-sidebar-title{padding:0 20px 16px;font-size:0.7rem;font-weight:700;letter-spacing:0.15em;text-transform:uppercase;color:#555;border-bottom:1px solid #1a1a1a;margin-bottom:8px}
.admin-nav-link{display:flex;align-items:center;gap:12px;padding:11px 20px;font-size:0.88rem;color:#aaa;cursor:pointer;transition:color var(--transition),background var(--transition)}
.admin-nav-link:hover,.admin-nav-link.active{color:var(--white);background:#1a1a1a}
.admin-nav-link.active{border-left:3px solid var(--red)}
.admin-main{flex:1;background:var(--gray-100);padding:24px;overflow-y:auto}
.admin-header{display:flex;justify-content:space-between;align-items:center;margin-bottom:24px;flex-wrap:wrap;gap:12px}
.admin-title{font-family:'Playfair Display',serif;font-size:1.5rem;font-weight:800}
.admin-btn{padding:9px 18px;background:var(--red);color:var(--white);border-radius:7px;font-size:0.85rem;font-weight:600;transition:background var(--transition)}
.admin-btn:hover{background:var(--red-dark)}
.stats-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:14px;margin-bottom:24px}
@media(min-width:640px){.stats-grid{grid-template-columns:repeat(4,1fr)}}
.stat-card{background:var(--white);border-radius:12px;padding:18px;box-shadow:0 2px 12px rgba(0,0,0,0.06)}
.stat-icon{width:38px;height:38px;border-radius:8px;display:flex;align-items:center;justify-content:center;margin-bottom:10px;font-size:1.1rem}
.stat-value{font-size:1.5rem;font-weight:800;margin-bottom:2px}
.stat-label{font-size:0.75rem;color:var(--gray-500);font-weight:500}
.stat-change{font-size:0.72rem;color:#22c55e;font-weight:600;margin-top:4px}
.admin-table-wrap{background:var(--white);border-radius:12px;overflow:hidden;box-shadow:0 2px 12px rgba(0,0,0,0.06)}
.admin-table-header{padding:16px 20px;border-bottom:1px solid var(--gray-200);display:flex;align-items:center;justify-content:space-between}
.admin-table-title{font-weight:700;font-size:0.95rem}
table{width:100%;border-collapse:collapse}
th{background:var(--gray-100);padding:10px 16px;text-align:left;font-size:0.75rem;font-weight:700;letter-spacing:0.08em;text-transform:uppercase;color:var(--gray-500);white-space:nowrap}
td{padding:12px 16px;border-bottom:1px solid var(--gray-200);font-size:0.85rem;vertical-align:middle}
tr:last-child td{border-bottom:none}
.status-pill{display:inline-block;padding:3px 10px;border-radius:20px;font-size:0.72rem;font-weight:700}
.status-pending{background:#fff7e6;color:#d97706}
.status-delivered{background:#e8f5e9;color:#16a34a}
.status-processing{background:#eff6ff;color:#2563eb}
.status-cancelled{background:#fef2f2;color:#dc2626}
.edit-btn{padding:5px 12px;border-radius:6px;font-size:0.78rem;font-weight:600;background:var(--black);color:var(--white);margin-right:5px;transition:background var(--transition)}
.edit-btn:hover{background:#333}
.del-btn{padding:5px 12px;border-radius:6px;font-size:0.78rem;font-weight:600;background:#fef2f2;color:var(--red);transition:background var(--transition)}
.del-btn:hover{background:var(--red);color:var(--white)}
.admin-product-form{background:var(--white);border-radius:12px;padding:24px;box-shadow:0 2px 12px rgba(0,0,0,0.06)}
.admin-form-title{font-weight:700;font-size:1rem;margin-bottom:18px}
.admin-form-grid{display:grid;grid-template-columns:1fr;gap:14px}
@media(min-width:640px){.admin-form-grid{grid-template-columns:1fr 1fr}}
.admin-input{padding:10px 14px;border-radius:8px;border:1.5px solid var(--gray-200);font-size:0.88rem;width:100%;outline:none;transition:border-color var(--transition)}
.admin-input:focus{border-color:var(--black)}
.upload-area{border:2px dashed var(--gray-300);border-radius:10px;padding:32px;text-align:center;cursor:pointer;transition:border-color var(--transition)}
.upload-area:hover{border-color:var(--black)}
.upload-icon{font-size:2rem;margin-bottom:8px}
.upload-text{font-size:0.85rem;color:var(--gray-500)}

/* ======= LOGIN PAGE ======= */
#login-page{display:none;min-height:100vh;align-items:center;justify-content:center;padding:100px 16px 40px;background:var(--gray-100)}
.auth-box{background:var(--white);border-radius:16px;padding:32px;max-width:400px;width:100%;box-shadow:var(--shadow-lg)}
.auth-logo{text-align:center;margin-bottom:24px}
.auth-title{font-family:'Playfair Display',serif;font-size:1.5rem;font-weight:800;text-align:center;margin-bottom:6px}
.auth-sub{font-size:0.85rem;color:var(--gray-500);text-align:center;margin-bottom:24px}
.auth-form{display:flex;flex-direction:column;gap:14px}
.auth-btn{padding:13px;background:var(--black);color:var(--white);border-radius:var(--btn-radius);font-weight:700;font-size:0.95rem;transition:background var(--transition)}
.auth-btn:hover{background:var(--red)}
.auth-footer{text-align:center;font-size:0.83rem;color:var(--gray-500);margin-top:16px}
.auth-footer a{color:var(--red);font-weight:600}

/* ======= ABOUT PAGE ======= */
#about-page{display:none;padding:80px 0 40px}
.about-hero{display:grid;gap:32px;align-items:center;margin-bottom:56px}
@media(min-width:768px){.about-hero{grid-template-columns:1fr 1fr}}
.about-img{border-radius:16px;overflow:hidden;aspect-ratio:4/3}
.about-img img{width:100%;height:100%;object-fit:cover}
.about-text h1{font-family:'Playfair Display',serif;font-size:clamp(1.6rem,4vw,2.4rem);font-weight:900;margin-bottom:16px;line-height:1.15}
.about-text p{font-size:0.9rem;color:var(--gray-700);line-height:1.8;margin-bottom:14px}
.about-stats{display:grid;grid-template-columns:repeat(2,1fr);gap:16px;margin-top:28px}
@media(min-width:480px){.about-stats{grid-template-columns:repeat(4,1fr)}}
.about-stat{text-align:center;background:var(--gray-100);border-radius:12px;padding:18px 8px}
.about-stat-num{font-size:1.6rem;font-weight:900;color:var(--red)}
.about-stat-lbl{font-size:0.75rem;color:var(--gray-500);margin-top:2px}

/* ======= CONTACT PAGE ======= */
#contact-page{display:none;padding:80px 0 40px}
.contact-grid{display:grid;gap:32px}
@media(min-width:768px){.contact-grid{grid-template-columns:1fr 1fr}}
.contact-info-card{background:var(--black);color:var(--white);border-radius:16px;padding:32px}
.contact-info-card h2{font-family:'Playfair Display',serif;font-size:1.5rem;font-weight:800;margin-bottom:10px}
.contact-info-card p{color:#aaa;font-size:0.88rem;line-height:1.7;margin-bottom:24px}
.contact-item{display:flex;gap:14px;margin-bottom:20px;align-items:flex-start}
.contact-icon{width:38px;height:38px;background:#1a1a1a;border-radius:8px;display:flex;align-items:center;justify-content:center;flex-shrink:0;font-size:1rem}
.contact-item-text p:first-child{font-weight:600;font-size:0.88rem;margin-bottom:3px}
.contact-item-text p:last-child{font-size:0.82rem;color:#888}
.contact-form-box{background:var(--white);border-radius:16px;padding:32px;border:1px solid var(--gray-200)}
.contact-form-box h2{font-family:'Playfair Display',serif;font-size:1.3rem;font-weight:800;margin-bottom:20px}
.contact-form{display:flex;flex-direction:column;gap:14px}
.form-textarea{padding:10px 14px;border-radius:8px;border:1.5px solid var(--gray-200);font-size:0.88rem;resize:vertical;min-height:120px;outline:none;transition:border-color var(--transition);width:100%}
.form-textarea:focus{border-color:var(--black)}
.submit-btn{padding:13px;background:var(--black);color:var(--white);border-radius:var(--btn-radius);font-weight:700;transition:background var(--transition)}
.submit-btn:hover{background:var(--red)}

/* ======= TOAST ======= */
#toast-container{position:fixed;bottom:80px;left:50%;transform:translateX(-50%);z-index:2000;display:flex;flex-direction:column;gap:8px;pointer-events:none;min-width:220px}
.toast{background:var(--black);color:var(--white);padding:12px 20px;border-radius:10px;font-size:0.85rem;font-weight:500;opacity:0;transform:translateY(10px);transition:all 0.3s;pointer-events:none;text-align:center;box-shadow:0 4px 20px rgba(0,0,0,0.25)}
.toast.show{opacity:1;transform:translateY(0)}
.toast.success{background:#16a34a}
.toast.error{background:var(--red)}

/* ======= PAGE TRANSITIONS ======= */
.page{display:none}
.page.active{display:block}
#home-page{display:block}

/* ======= MISC ======= */
.divider{height:1px;background:var(--gray-200);margin:0}
.text-red{color:var(--red)}
.empty-cart{padding:40px;text-align:center;color:var(--gray-500)}
.empty-cart svg{width:60px;height:60px;margin:0 auto 16px;opacity:0.3}
.empty-cart p{font-size:0.9rem;margin-bottom:16px}
.empty-cart button{padding:10px 22px;background:var(--black);color:var(--white);border-radius:var(--btn-radius);font-size:0.88rem;font-weight:600}

/* SCROLLBAR */
::-webkit-scrollbar{width:6px}
::-webkit-scrollbar-track{background:var(--gray-100)}
::-webkit-scrollbar-thumb{background:var(--gray-300);border-radius:3px}
</style>
</head>

// ======== ADMIN ========
function openAdminPanel(){
  showPage('admin');
}
function verifyAdmin(){
  const id = document.getElementById('admin-id').value;
  const pass = document.getElementById('admin-pass').value;
  if(id==='PRAHULADMIN'&&pass==='123456'){
    document.getElementById('admin-login-gate').style.display='none';
    document.getElementById('admin-dashboard').style.display='flex';
    renderAdminProducts();
    showToast('Welcome, Admin PRAHUL!','success');
  } else {
    showToast('Invalid credentials!','error');
  }
}
function logoutAdmin(){
  document.getElementById('admin-dashboard').style.display='none';
  document.getElementById('admin-login-gate').style.display='flex';
  document.getElementById('admin-id').value='';
  document.getElementById('admin-pass').value='';
  showPage('home');
}
function switchAdmin(view, el){
  ['dashboard','products','orders','customers','add-product'].forEach(v=>{
    const d=document.getElementById(`admin-${v}-view`);
    if(d) d.style.display = v===view?'block':'none';
  });
  document.querySelectorAll('.admin-nav-link').forEach(a=>a.classList.remove('active'));
  if(el) el.classList.add('active');
}
function renderAdminProducts(){
  const tbody = document.getElementById('admin-products-table');
  if(!tbody) return;
  tbody.innerHTML = products.map(p=>`
    <tr>
      <td><img src="${p.image}" style="width:48px;height:48px;object-fit:cover;border-radius:6px"></td>
      <td><strong>${p.name}</strong></td>
      <td>${p.category}</td>
      <td>৳${p.price.toLocaleString()}</td>
      <td>${p.stock>5?'<span style="color:#22c55e">'+p.stock+' in stock</span>':'<span style="color:var(--red)">Low: '+p.stock+'</span>'}</td>
      <td><button class="edit-btn" onclick="showToast('Edit mode for: ${p.name.replace(/'/g,"\\'")}')">Edit</button><button class="del-btn" onclick="showToast('Product deleted!','error')">Delete</button></td>
    </tr>`).join('');
}
function adminAddProduct(){
  const name=document.getElementById('ap-name').value;
  const price=parseInt(document.getElementById('ap-price').value)||0;
  const cat=document.getElementById('ap-cat').value;
  const stock=parseInt(document.getElementById('ap-stock').value)||0;
  const img=document.getElementById('ap-img').value||'https://images.unsplash.com/photo-1555041469-a586c61ea9bc?w=400&q=80';
  const oprice=parseInt(document.getElementById('ap-oprice').value)||0;
  const desc=document.getElementById('ap-desc').value;
  if(!name||!price){showToast('Please fill required fields','error');return;}
  const newProd = {
    id: products.length+1, name, brand:'Alif Steel', category:cat,
    price, oldPrice:oprice||null, discount:oprice?Math.round((oprice-price)/oprice*100):0,
    rating:4.5, reviews:0, image:img, badge:'new', colors:['#1a1a1a'],
    sizes:['Standard'], stock, description:desc, featured:false, bestseller:false
  };
  products.push(newProd);
  showToast('Product added successfully!','success');
  renderAdminProducts();
  switchAdmin('products',null);
  document.querySelectorAll('.admin-nav-link')[1].classList.add('active');
}

// ======== RESPONSIVE SHOP LAYOUT ========
function adjustShopLayout(){
  const shopLayout = document.querySelector('.shop-layout');
  if(!shopLayout) return;
  if(window.innerWidth < 768){
    shopLayout.style.gridTemplateColumns = '1fr';
    document.getElementById('shop-filters').style.display = 'none';
  } else {
    shopLayout.style.gridTemplateColumns = '220px 1fr';
    document.getElementById('shop-filters').style.display = 'block';
  }
}
window.addEventListener('resize', adjustShopLayout);
adjustShopLayout();
</script>
